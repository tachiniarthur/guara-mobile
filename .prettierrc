{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "apps/mobile/**",
      "options": {
        "tailwindConfig": "./apps/mobile/tailwind.config.js"
      }
    }
  ]
}
