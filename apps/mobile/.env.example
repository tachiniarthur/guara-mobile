# Copie para .env (não versionado) e preencha.
#
# Nenhuma chave secreta vai para o app.
# Claude, Malvo, Brapi e a service role do Supabase ficam SÓ na API NestJS.
# Tudo que começa com EXPO_PUBLIC_ é embutido no bundle e pode ser lido por qualquer pessoa.

# URL da API:
# - emulador Android: http://10.0.2.2:3000
# - aparelho físico com Expo Go na mesma rede: http://<IP-do-computador-na-rede>:3000
#
# ⚠️ Com `pnpm dev:tunnel` (padrão para aparelho físico no WSL2), o túnel leva o APP até o Metro,
#    mas NÃO expõe uma API rodando em localhost no WSL. Quando a API NestJS existir, aponte esta
#    variável para uma URL acessível pelo celular (túnel próprio da API ou ambiente publicado).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Supabase (somente autenticação). A anon key é pública por design; a service role NUNCA.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origem dos dados que as telas recebem:
# - mock: dados falsos em memória (src/mocks), sem API. Só existe em builds de desenvolvimento.
# - api:  API NestJS em EXPO_PUBLIC_API_URL.
# Vazio = mock em desenvolvimento e api nos builds de release. A variante production só aceita api.
EXPO_PUBLIC_DATA_SOURCE=mock
