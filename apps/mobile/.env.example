# Copie para .env (não versionado) e preencha.
#
# Nenhuma chave secreta vai para o app.
# Claude, Malvo, Brapi e a service role do Supabase ficam SÓ na API NestJS.
# Tudo que começa com EXPO_PUBLIC_ é embutido no bundle e pode ser lido por qualquer pessoa.

# URL da API local:
# - emulador Android: http://10.0.2.2:3000
# - aparelho físico com Expo Go (iPhone ou Android): http://<IP-do-computador-na-rede>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Supabase (somente autenticação). A anon key é pública por design; a service role NUNCA.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
