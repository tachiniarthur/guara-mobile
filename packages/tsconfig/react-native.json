{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Guar\u00e1 React Native (Expo)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
